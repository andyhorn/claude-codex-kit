{
  "model": "opusplan",
  "permissions": {
    "allow": [
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get:*)",
      "Bash(dart format:*)",
      "Bash(dart run build_runner:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(*/scripts/verify.sh:*)",
      "Bash(*/codex-delegate/scripts/delegate.sh:*)",
      "Bash(*/codex-delegate/scripts/draft-spec.sh:*)"
    ],
    "deny": [
      "Read(**/*.g.dart)",
      "Read(**/*.freezed.dart)",
      "Read(**/*.gr.dart)",
      "Read(**/build/**)",
      "Read(**/.dart_tool/**)",
      "Read(**/pubspec.lock)",
      "Read(**/Pods/**)"
    ]
  }
}
